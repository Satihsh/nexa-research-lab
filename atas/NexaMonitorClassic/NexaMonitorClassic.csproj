<Project Sdk="Microsoft.NET.Sdk">
  <!-- NEXA Monitor for CLASSIC ATAS on Windows (used on the GPU-less cloud VM, where ATAS X cannot render).
       Same source files as ../NexaMonitor; built against classic ATAS's own libraries (copied from the VM to ../refs_classic,
       not committed). Output DLL name stays NexaMonitor.dll. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NexaMonitor</AssemblyName>
    <RootNamespace>Nexa.Atas</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ATAS_BASE>$(MSBuildThisFileDirectory)../refs_classic</ATAS_BASE>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../NexaMonitor/*.cs" />
    <Reference Include="ATAS.Indicators"><HintPath>$(ATAS_BASE)/ATAS.Indicators.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ATAS.DataFeedsCore"><HintPath>$(ATAS_BASE)/ATAS.DataFeedsCore.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="OFT.Attributes"><HintPath>$(ATAS_BASE)/OFT.Attributes.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="OFT.Rendering"><HintPath>$(ATAS_BASE)/OFT.Rendering.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Utils.Common"><HintPath>$(ATAS_BASE)/Utils.Common.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
